# Safe defaults: local deterministic research and simulated execution.
AQS_ENVIRONMENT=paper
AQS_RESEARCH_PROVIDER=static
AQS_EXECUTION_PROVIDER=paper
AQS_LIVE_TRADING_ENABLED=false
AQS_LIVE_CONFIRMATION=

# TradingAgents (used only when AQS_RESEARCH_PROVIDER=tradingagents).
AQS_LLM_PROVIDER=openai
AQS_QUICK_THINK_LLM=gpt-5-mini
AQS_DEEP_THINK_LLM=gpt-5
AQS_AGENT_TARGET_WEIGHT=0.05
OPENAI_API_KEY=

# Hard risk limits. Agent output cannot override these values.
AQS_MIN_CONFIDENCE=0.65
AQS_MAX_POSITION_WEIGHT=0.10
AQS_MAX_ORDER_NOTIONAL=5000
AQS_MAX_GROSS_EXPOSURE=1.00
AQS_MAX_DAILY_LOSS_FRACTION=0.02
AQS_ALLOW_SHORT=false
AQS_ALLOW_FRACTIONAL_SHARES=true

# IBKR paper monitoring and execution; live accounts are rejected.
AQS_IB_ACCOUNT_ID=
AQS_IB_GATEWAY_HOST=127.0.0.1
AQS_IB_GATEWAY_PORT=4002
AQS_IB_CLIENT_ID=71
AQS_IB_TIMEOUT_SECONDS=15
AQS_PAPER_TRADING_ENABLED=false
AQS_MONITOR_SYMBOLS=AAPL,MSFT,NVDA,AMZN,GOOGL
AQS_MONITOR_INTERVAL_SECONDS=60
AQS_MONITOR_STATE_PATH=data/monitor.sqlite3
AQS_MONITOR_STOP_PATH=data/STOP
AQS_MAX_SIGNAL_AGE_SECONDS=300
AQS_QUOTE_MAX_AGE_SECONDS=30
AQS_MAX_SPREAD_BPS=20
AQS_ORDER_LIMIT_OFFSET_BPS=5
AQS_ORDER_CASH_BUFFER=5
AQS_STRATEGY_MODE=daily
AQS_INTRADAY_SYMBOLS=SPY,QQQ
AQS_INTRADAY_INTERVAL_SECONDS=5
AQS_INTRADAY_MAX_GROSS=0.30
AQS_INTRADAY_DAILY_LOSS=0.01
AQS_INTRADAY_CASH_RESERVE=0.05
AQS_INTRADAY_MAX_POSITIONS=3
AQS_INTRADAY_MAX_ENTRIES=10
AQS_INTRADAY_STOP_FRACTION=0.005
AQS_INTRADAY_ENTRY_TIMEOUT=60
AQS_INTRADAY_ACK_TIMEOUT=180
# For intraday mode use its own persistent state and stop paths:
# AQS_MONITOR_STATE_PATH=data/intraday.sqlite3
# AQS_MONITOR_STOP_PATH=data/INTRADAY_STOP
# Optional HTTPS JSON webhook; omit when using console notifications only.
# AQS_NOTIFICATION_WEBHOOK=https://your-notification-endpoint
